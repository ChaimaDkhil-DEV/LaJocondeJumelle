// Modèle de données du lot 1 — voir specs/001-demandes-travail-vocales/data-model.md
// Identifiants UUID, horodatages en UTC (timestamptz). Les tables RequestEvent et AuditLog
// sont en ajout seul : des triggers PostgreSQL (migration 0001_init) bloquent UPDATE,
// DELETE et TRUNCATE.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  EMPLOYEE
}

enum Priority {
  NORMAL
  MEDIUM
  HIGH
  URGENT
}

enum RequestStatus {
  DRAFT
  PENDING_ADMIN_VALIDATION
  SENT
  ACCEPTED
  IN_PROGRESS
  DONE
  PENDING_FINAL_VALIDATION
  TO_CORRECT
  CLOSED
  REJECTED
  CANCELLED
  // Couverture de classe (lot 2) — voir src/coverage/domain/coverage-state-machine.ts
  BROADCAST
  UNFILLED
  EN_ROUTE
  LATE
  ON_DUTY
  RELIEF_PENDING
}

/// Nature d'une demande ou d'une catégorie : demande de travail (lot 1) ou couverture de classe (lot 2).
enum RequestKind {
  WORK
  COVERAGE
}

/// Preuve de présence exigée pour une couverture : photo, QR code de la classe, ou les deux.
enum ProofMode {
  PHOTO
  QR
  BOTH
}

enum PresenceMethod {
  PHOTO
  QR
}

/// Disponibilité déclarée d'un employé pour les couvertures. ABSENT : réservé aux responsables.
enum Availability {
  AVAILABLE
  UNAVAILABLE
  ABSENT
}

enum Circuit {
  A_DIRECT
  B_ADMIN_VALIDATION
}

/// Routage d'une catégorie de demandes de travail (le circuit en est déduit) :
/// VIA_ADMIN : validation par l'administration (circuit B) ; DIRECT : vers le service, sans validation ;
/// PEER : d'un enseignant à un autre, sans validation. En DIRECT et PEER, l'administration consulte
/// en lecture seule. Sans effet sur les catégories de couverture.
enum RoutingMode {
  VIA_ADMIN
  DIRECT
  PEER
}

enum ClosureMode {
  AUTO
  REQUESTER
  MANAGER
}

enum AssignmentMode {
  MANUAL
  AUTO
}

enum DeadlineStage {
  VALIDATION
  TAKEOVER
  COMPLETION
  /// Couverture : arrivée en classe après acceptation.
  ARRIVAL
}

enum MessageKind {
  TEXT
  VOICE
  SYSTEM
}

enum FileKind {
  VOICE
  PHOTO
  DOCUMENT
}

enum Permission {
  REQUEST_CREATE
  PRIORITY_CHANGE_OWN
  PRIORITY_CHANGE_MANAGED
  REQUEST_REASSIGN
  AUDIT_READ
  ADMIN_MANAGE
}

enum RequestEventType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  REASSIGNED
  MESSAGE_ADDED
  FILE_ADDED
  OVERDUE
  // Couverture de classe
  GROUP_ADDED
  RELEASED
  RELIEF_REQUESTED
  PRESENCE_CONFIRMED
  EXTENDED
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  ACCESS_DENIED
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  PASSWORD_RESET
  PASSWORD_CHANGED
  ROLE_PERMISSIONS_CHANGED
  CATEGORY_CHANGED
  DEADLINE_RULE_CHANGED
  SETTING_CHANGED
  // Couverture de classe
  GROUP_CHANGED
  CLASS_CHANGED
  QR_REVOKED
  AVAILABILITY_CHANGED
  COVERAGE_MANAGED
  COVERAGE_CREATED
  // Demandes de travail : actions administratives
  REQUEST_MANAGED
}

enum NotificationType {
  REQUEST_NEW
  MESSAGE_NEW
  ASSIGNED
  STATUS_CHANGED
  URGENT
  TO_CORRECT
  REJECTED
  CANCELLED
  OVERDUE
  CLOSED
  // Couverture de classe
  COVERAGE_NEW
  COVERAGE_TAKEN
  COVERAGE_ACCEPTED
  COVERAGE_PRESENCE
  COVERAGE_RELEASED
  COVERAGE_RELIEF_REQUESTED
  COVERAGE_LATE
  COVERAGE_UNFILLED
  COVERAGE_EXTENDED
  COVERAGE_RELIEVED
  /// Super administrateur : demande active sans employé affecté, délai bientôt dépassé.
  UNASSIGNED
}

/// Utilisateur. `username` est unique et insensible à la casse : il est toujours
/// stocké en minuscules (3–64 caractères, contrôlé par les DTO).
model User {
  id                 String       @id @default(uuid()) @db.Uuid
  username           String       @unique @db.VarChar(64)
  displayName        String       @db.VarChar(100)
  jobTitle           String?      @db.VarChar(100)
  role               Role
  passwordHash       String
  mustChangePassword Boolean      @default(true)
  active             Boolean      @default(true)
  /// Couverture de classe : disponibilité déclarée (les gardes en cours sont calculées à part).
  availability       Availability @default(AVAILABLE)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)

  sessions         Session[]
  recipientOf      CategoryRecipient[]
  managerOf        CategoryManager[]
  autoAssigneeOf   Category[]            @relation("CategoryAutoAssignee")
  requestsCreated  Request[]             @relation("RequestRequester")
  requestsAssigned Request[]             @relation("RequestAssignee")
  messages         Message[]
  filesUploaded    File[]
  requestEvents    RequestEvent[]
  auditEntries     AuditLog[]
  notifications    Notification[]
  settingsUpdated  Setting[]
  groupMemberships EmployeeGroupMember[]
  presences        CoveragePresence[]
}

/// Session serveur : `id` est le haché HMAC du jeton aléatoire (256 bits) placé dans le cookie.
model Session {
  id         String   @id @db.VarChar(128)
  userId     String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  ip         String?  @db.VarChar(64)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// Permissions configurables par rôle. SUPER_ADMIN a toujours toutes les permissions (non stocké).
model RolePermission {
  role       Role
  permission Permission

  @@id([role, permission])
}

model Category {
  id                    String         @id @default(uuid()) @db.Uuid
  name                  String         @unique @db.VarChar(60)
  active                Boolean        @default(true)
  circuit               Circuit
  /// Mode de routage ; `circuit` en est déduit (VIA_ADMIN : circuit B ; DIRECT, PEER : circuit A).
  routingMode           RoutingMode    @default(DIRECT)
  creatorRoles          Role[]
  closureMode           ClosureMode
  /// Délai de grâce avant clôture automatique (closureMode = AUTO) ; 0 = immédiat.
  autoCloseAfterMinutes Int            @default(1440)
  /// Circuit B uniquement.
  finalValidation       Boolean        @default(false)
  /// Circuit B uniquement.
  assignmentMode        AssignmentMode @default(MANUAL)
  /// Obligatoire si assignmentMode = AUTO.
  autoAssigneeId        String?        @db.Uuid
  photoRequired         Boolean        @default(false)
  /// WORK ou COVERAGE ; fixé à la création, jamais modifiable.
  kind                  RequestKind    @default(WORK)
  /// Couverture uniquement : preuve de présence exigée.
  proofMode             ProofMode      @default(PHOTO)
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)

  autoAssignee  User?               @relation("CategoryAutoAssignee", fields: [autoAssigneeId], references: [id])
  recipients    CategoryRecipient[]
  managers      CategoryManager[]
  deadlineRules DeadlineRule[]
  requests      Request[]
}

/// Destinataires possibles (circuit A) et employés affectables (circuit B).
model CategoryRecipient {
  categoryId String @db.Uuid
  userId     String @db.Uuid

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@id([categoryId, userId])
  @@index([userId])
}

/// Responsables de la catégorie (rôle MANAGER ou SUPER_ADMIN).
model CategoryManager {
  categoryId String @db.Uuid
  userId     String @db.Uuid

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@id([categoryId, userId])
  @@index([userId])
}

/// Durées en minutes ; null = étape non suivie.
model DeadlineRule {
  id                String   @id @default(uuid()) @db.Uuid
  categoryId        String   @db.Uuid
  priority          Priority
  validationMinutes Int?
  takeoverMinutes   Int?
  completionMinutes Int?
  /// Couverture : délai d'arrivée en classe après acceptation.
  arrivalMinutes    Int?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, priority])
}

/// Réglage global typé (clé/valeur), modifiable par le super administrateur.
model Setting {
  key         String   @id @db.VarChar(64)
  value       Json
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedById String?  @db.Uuid

  updatedBy User? @relation(fields: [updatedById], references: [id])
}

model Request {
  id               String         @id @default(uuid()) @db.Uuid
  /// WORK : demande de travail ; COVERAGE : couverture de classe (détail dans CoverageDetail).
  kind             RequestKind    @default(WORK)
  /// Numéro séquentiel servant à construire `reference` (D-AAAA-NNNNNN).
  number           Int            @unique @default(autoincrement())
  reference        String         @unique @db.VarChar(20)
  /// Idempotence des renvois : unique par (requesterId, clientId).
  clientId         String         @db.Uuid
  title            String         @db.VarChar(120)
  description      String?        @db.VarChar(4000)
  voiceFileId      String?        @unique @db.Uuid
  categoryId       String         @db.Uuid
  priority         Priority
  requesterId      String         @db.Uuid
  assigneeId       String?        @db.Uuid
  status           RequestStatus
  /// Verrouillage optimiste.
  version          Int            @default(0)
  /// Copie des règles de la catégorie à la création (FR-022).
  rulesSnapshot    Json
  currentStage     DeadlineStage?
  currentDueAt     DateTime?      @db.Timestamptz(3)
  warnAt           DateTime?      @db.Timestamptz(3)
  overdueStage     DeadlineStage?
  autoCloseAt      DateTime?      @db.Timestamptz(3)
  rejectionReason  String?        @db.VarChar(1000)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  submittedAt      DateTime?      @db.Timestamptz(3)
  approvedAt       DateTime?      @db.Timestamptz(3)
  rejectedAt       DateTime?      @db.Timestamptz(3)
  assignedAt       DateTime?      @db.Timestamptz(3)
  acceptedAt       DateTime?      @db.Timestamptz(3)
  startedAt        DateTime?      @db.Timestamptz(3)
  doneAt           DateTime?      @db.Timestamptz(3)
  finalValidatedAt DateTime?      @db.Timestamptz(3)
  closedAt         DateTime?      @db.Timestamptz(3)
  cancelledAt      DateTime?      @db.Timestamptz(3)
  /// Alertes du super administrateur : une seule fois par demande et par type, marqueur posé par
  /// mise à jour conditionnelle (urgente, sans employé affecté, en retard).
  superAdminUrgentNotifiedAt     DateTime? @db.Timestamptz(3)
  superAdminUnassignedNotifiedAt DateTime? @db.Timestamptz(3)
  superAdminOverdueNotifiedAt    DateTime? @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  voiceFile     File?              @relation("RequestVoice", fields: [voiceFileId], references: [id])
  category      Category           @relation(fields: [categoryId], references: [id])
  requester     User               @relation("RequestRequester", fields: [requesterId], references: [id])
  assignee      User?              @relation("RequestAssignee", fields: [assigneeId], references: [id])
  files         File[]             @relation("RequestFiles")
  messages      Message[]
  events        RequestEvent[]
  notifications Notification[]
  coverage      CoverageDetail?
  reliefOf      CoverageDetail[]   @relation("CoverageRelief")
  presences     CoveragePresence[]

  @@unique([requesterId, clientId])
  @@index([kind, status])
  @@index([status])
  @@index([categoryId])
  @@index([assigneeId])
  @@index([requesterId])
  @@index([priority])
  @@index([createdAt])
  @@index([currentDueAt])
}

model Message {
  id          String      @id @default(uuid()) @db.Uuid
  requestId   String      @db.Uuid
  /// null pour les messages SYSTEM.
  authorId    String?     @db.Uuid
  clientId    String?     @db.Uuid
  kind        MessageKind
  text        String?     @db.VarChar(4000)
  voiceFileId String?     @unique @db.Uuid
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  request     Request @relation(fields: [requestId], references: [id])
  author      User?   @relation(fields: [authorId], references: [id])
  voiceFile   File?   @relation("MessageVoice", fields: [voiceFileId], references: [id])
  attachments File[]  @relation("MessageAttachments")

  @@unique([authorId, clientId])
  @@index([requestId, createdAt])
}

/// Vocal, photo ou document. Stocké sous FILES_DIR ; `storagePath` n'est jamais exposé.
/// `requestId` est null tant que le fichier est provisoire (supprimé sous 24 h s'il n'est pas rattaché).
model File {
  id                String   @id @default(uuid()) @db.Uuid
  requestId         String?  @db.Uuid
  messageId         String?  @db.Uuid
  uploaderId        String   @db.Uuid
  kind              FileKind
  mimeType          String   @db.VarChar(100)
  originalName      String   @db.VarChar(255)
  sizeBytes         Int
  durationSeconds   Decimal? @db.Decimal(7, 2)
  storagePath       String   @db.VarChar(255)
  isCompletionProof Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  request        Request?          @relation("RequestFiles", fields: [requestId], references: [id])
  message        Message?          @relation("MessageAttachments", fields: [messageId], references: [id])
  uploader       User              @relation(fields: [uploaderId], references: [id])
  voiceOfRequest Request?          @relation("RequestVoice")
  voiceOfMessage Message?          @relation("MessageVoice")
  presence       CoveragePresence?

  @@index([requestId])
  @@index([messageId])
  @@index([createdAt])
}

/// Historique d'une demande — ajout seul (trigger).
model RequestEvent {
  id        String           @id @default(uuid()) @db.Uuid
  requestId String           @db.Uuid
  /// null = acteur SYSTEM (job planifié, règle automatique).
  actorId   String?          @db.Uuid
  type      RequestEventType
  fromValue Json?
  toValue   Json?
  comment   String?          @db.VarChar(1000)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  /// Ordre d'écriture : départage les événements de même horodatage (N3).
  seq       BigInt           @default(autoincrement())

  request Request @relation(fields: [requestId], references: [id])
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([requestId, createdAt])
  /// Tableau de bord : fil d'activité paginé par ordre d'écriture.
  @@index([seq])
  /// Tableau de bord : dernière action de chaque employé.
  @@index([actorId, createdAt])
}

/// Journal d'audit des actions sensibles — ajout seul (trigger).
/// `details` ne contient jamais de mot de passe, jeton ni contenu de message.
model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  actorId    String?     @db.Uuid
  action     AuditAction
  targetType String?     @db.VarChar(40)
  targetId   String?     @db.VarChar(64)
  details    Json?
  ip         String?     @db.VarChar(64)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  requestId String           @db.Uuid
  /// Copie de la priorité de la demande, pour l'affichage distinct des urgences.
  priority  Priority
  readAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id])
  request Request @relation(fields: [requestId], references: [id])

  @@index([userId, readAt])
  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Couverture de classe (lot 2)
// ---------------------------------------------------------------------------

/// Classe ou salle. Le QR code imprimé encode un jeton HMAC (classe + qrVersion) ;
/// incrémenter qrVersion révoque tous les QR déjà imprimés.
model SchoolClass {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(80)
  room      String?  @db.VarChar(80)
  active    Boolean  @default(true)
  qrVersion Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  coverages CoverageDetail[]
}

/// Groupe d'employés ciblé par les couvertures (ex. Surveillants/Remplaçants).
model EmployeeGroup {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(60)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  members EmployeeGroupMember[]
  targets CoverageTarget[]
}

model EmployeeGroupMember {
  groupId String @db.Uuid
  userId  String @db.Uuid

  group EmployeeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id])

  @@id([groupId, userId])
  @@index([userId])
}

/// Détail 1-1 d'une demande de couverture (Request.kind = COVERAGE).
/// Toutes les heures sont posées par le serveur.
model CoverageDetail {
  requestId        String    @id @db.Uuid
  classId          String    @db.Uuid
  absentTeacher    String?   @db.VarChar(100)
  startAt          DateTime  @db.Timestamptz(3)
  /// null = jusqu'à l'arrivée de l'enseignant.
  estimatedMinutes Int?
  /// startAt + estimatedMinutes (recalculé à chaque prolongation) ; null = fin ouverte.
  plannedEndAt     DateTime? @db.Timestamptz(3)
  broadcastAt      DateTime? @db.Timestamptz(3)
  departedAt       DateTime? @db.Timestamptz(3)
  presenceAt       DateTime? @db.Timestamptz(3)
  relievedAt       DateTime? @db.Timestamptz(3)
  /// Durée de garde (présence → relève), en minutes.
  durationMinutes  Int?
  releaseCount     Int       @default(0)
  extensionCount   Int       @default(0)
  cancelReason     String?   @db.VarChar(1000)
  /// Demande de relève : garde d'origine à relever quand le remplaçant confirme sa présence.
  reliefForId      String?   @db.Uuid

  request   Request          @relation(fields: [requestId], references: [id])
  class     SchoolClass      @relation(fields: [classId], references: [id])
  reliefFor Request?         @relation("CoverageRelief", fields: [reliefForId], references: [id])
  targets   CoverageTarget[]

  @@index([classId])
  @@index([startAt])
  @@index([reliefForId])
}

/// Groupes ciblés par une couverture (plusieurs après élargissement).
model CoverageTarget {
  requestId String   @db.Uuid
  groupId   String   @db.Uuid
  addedAt   DateTime @default(now()) @db.Timestamptz(3)

  coverage CoverageDetail @relation(fields: [requestId], references: [requestId], onDelete: Cascade)
  group    EmployeeGroup  @relation(fields: [groupId], references: [id])

  @@id([requestId, groupId])
  @@index([groupId])
}

/// Preuve de présence : heure serveur (jamais l'heure du client ni l'EXIF de la photo).
model CoveragePresence {
  id        String         @id @default(uuid()) @db.Uuid
  requestId String         @db.Uuid
  userId    String         @db.Uuid
  method    PresenceMethod
  fileId    String?        @unique @db.Uuid
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  request Request @relation(fields: [requestId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  file    File?   @relation(fields: [fileId], references: [id])

  @@index([requestId])
}
