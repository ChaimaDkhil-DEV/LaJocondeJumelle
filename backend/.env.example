# Copier en backend/.env et adapter. Ne jamais committer le fichier .env.

# Base de développement (embedded-postgres : `npm run -w backend db:dev`, port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app

# Secret HMAC des jetons de session : au moins 32 caractères aléatoires
SESSION_SECRET=remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum
# Secret de signature des QR codes imprimés (facultatif ; vide : SESSION_SECRET)
# QR_SIGNING_SECRET=

# Dossier privé des vocaux, photos et fichiers (jamais servi directement)
FILES_DIR=./data/files

# Origine autorisée (SPA) pour les requêtes modifiantes et le WebSocket
APP_ORIGIN=http://localhost:5173

# Développement seulement (refusé en production) : origines supplémentaires de ce poste, séparées par des virgules
# APP_LOCAL_ORIGINS=http://127.0.0.1:4173

# Environnement : development (défaut), test ou production ; toute autre valeur est refusée. Docker fixe production,
# et l'API refuse alors de démarrer si ce fichier existe.
# NODE_ENV=development

# Fuseau de l'école (identifiant IANA, défaut Europe/Paris)
# SCHOOL_TIMEZONE=Africa/Tunis

# Développement et tests seulement : tâches planifiées (false pour les arrêter), connexions par minute (défaut 5)
# JOBS_ENABLED=true
# LOGIN_RATE_LIMIT=5

# Port de l'API en développement (la production fixe 3000 dans deploy/api.Dockerfile).
PORT=3002

# Cookie de session Secure. Laisser à true en production (forcé si NODE_ENV=production).
# false uniquement en développement sur http://localhost, pour Safari/WebKit.
COOKIE_SECURE=false

# Proxys de confiance pour l'adresse IP cliente (X-Forwarded-For)
TRUST_PROXY=loopback

# Binaires ffmpeg/ffprobe (conversion des vocaux, à partir de la Phase 3)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Assistance IA à la création des demandes (specs 009 et 010). Désactivée par défaut.
# Propositions : disabled (défaut), demo (local, sans réseau ; refusé si NODE_ENV=production),
# rules (même moteur par règles que demo, autorisé en production, sans service ni frais)
# ou claude (connecteur réel payant, spec 010).
# Transcription : disabled (défaut), demo, ou whisper (serveur de l'établissement, spec 010).
# Les connecteurs réels envoient des données hors de l'application : ne les activer qu'après la
# décision de l'établissement (accord de traitement, durée de conservation).
ASSIST_SUGGESTION_PROVIDER=disabled
ASSIST_TRANSCRIPTION_PROVIDER=disabled
# Connecteur claude : clé secrète obligatoire (ne jamais la commiter), modèle facultatif.
# ANTHROPIC_API_KEY=
# ASSIST_CLAUDE_MODEL=claude-opus-5-5
# Connecteur whisper : adresse du serveur (https obligatoire en production), modèle et clé facultatifs.
# ASSIST_WHISPER_URL=https://whisper.ecole.example
# ASSIST_WHISPER_MODEL=Systran/faster-whisper-small
# ASSIST_WHISPER_API_KEY=
# Langue des vocaux : fr (défaut), autre code à deux lettres, ou auto
# ASSIST_WHISPER_LANGUAGE=fr
# Certificat d'autorité supplémentaire (autorité interne de Caddy en production), relu à chaque appel.
# ASSIST_WHISPER_CA_FILE=
# Développement avec le service « whisper » de deploy/docker-compose.dev.yml : http://127.0.0.1:8000
# Délai maximal d'un appel de propositions (1000 à 20000 ms, défaut 15000)
# ASSIST_TIMEOUT_MS=15000
# Délai maximal d'une transcription (1000 à 300000 ms, défaut 120000)
# ASSIST_TRANSCRIPTION_TIMEOUT_MS=120000
# Appels par utilisateur et par 5 minutes (défaut 10)
# ASSIST_RATE_LIMIT=10
# Texte de la transcription de démonstration (facultatif)
# ASSIST_DEMO_TRANSCRIPT=

# Notifications push (spec 014) : les trois ou aucune ; sans elles, le push est désactivé.
# N'activer qu'après la décision de l'établissement (registre des traitements, docs/notifications-push.md).
# Générer une paire de clés : npm exec -w backend -- web-push generate-vapid-keys
# Sujet : mailto: ou https: (contact de l'établissement), jamais localhost. Ne jamais commiter la clé privée.
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:direction@ecole.example

# Communication avec les parents (spec 015) : webhook n8n et secret partagé (32 caractères min.), les deux ou aucun ;
# canaux externes EMAIL, WHATSAPP (séparés par des virgules). Voir docs/parent-communications.md.
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/ljj-parent-communication
# N8N_SHARED_SECRET=
# N8N_TIMEOUT_MS=10000
# PARENT_COMM_CHANNELS=

# CAPTCHA de connexion (Cloudflare Turnstile) : les deux ou aucune ; sans elles, le CAPTCHA est désactivé.
# Développement : clés de test officielles de Cloudflare ci-dessous (toujours acceptées ; interdites en
# production). Ne jamais commiter une vraie clé secrète. Voir docs/captcha-turnstile.md.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
