# Copier en backend/.env et adapter. Ne jamais committer le fichier .env.

# Base de développement (embedded-postgres : `npm run -w backend db:dev`, port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app
# Base de test : démarrée automatiquement par les tests d'intégration (inutile de la renseigner)
DATABASE_URL_TEST=

# Secret HMAC des jetons de session : au moins 32 caractères aléatoires
SESSION_SECRET=remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum

# Dossier privé des vocaux, photos et fichiers (jamais servi directement)
FILES_DIR=./data/files

# Origine autorisée (SPA) pour les requêtes modifiantes et le WebSocket
APP_ORIGIN=http://localhost:5173

PORT=3000

# Cookie de session Secure. Laisser à true en production (forcé si NODE_ENV=production).
# false uniquement en développement sur http://localhost, pour Safari/WebKit.
COOKIE_SECURE=false

# Proxys de confiance pour l'adresse IP cliente (X-Forwarded-For)
TRUST_PROXY=loopback

# Binaires ffmpeg/ffprobe (conversion des vocaux, à partir de la Phase 3)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
