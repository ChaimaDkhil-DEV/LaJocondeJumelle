# Production : HTTPS automatique (Let's Encrypt) pour {$DOMAIN}.
# Variables : DOMAIN, ACME_EMAIL (voir deploy/.env.example) ; API_UPSTREAM et SITE_ROOT
# (défauts api:3000 et /srv) ne servent qu’aux tests locaux de cette configuration.
{
	email {$ACME_EMAIL}
	# Autorité interne (relais Whisper ci-dessous) : son certificat racine reste dans /data, rien
	# n'est installé dans le magasin du système.
	skip_install_trust
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# 'unsafe-inline' pour les styles uniquement : MUI (Emotion) injecte des balises <style>.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' wss:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# Micro (vocaux) et appareil photo (preuves) autorisés pour l'application elle-même seulement.
		Permissions-Policy "microphone=(self), camera=(self), geolocation=(), payment=(), usb=()"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API REST : corps limité au plafond technique des envois (25 Mo, files.controller) + marge
	# multipart. Le réglage attachmentMaxBytes (25 Mo au plus) est ensuite appliqué par l'API.
	handle /api/* {
		request_body {
			max_size 26MB
		}
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# Temps réel (Socket.IO, WebSocket).
	handle /socket.io/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# SPA : fichiers versionnés mis en cache longtemps ; repli sur index.html pour les routes du client.
	handle {
		root * {$SITE_ROOT:/srv}
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Éditeur n8n (spec 015, profil « n8n » de docker-compose.yml) : sous-domaine N8N_DOMAIN en HTTPS,
# réservé aux adresses N8N_ALLOWED_IPS (par défaut : aucune adresse extérieure ; accès par tunnel SSH).
# Sans N8N_DOMAIN, le site n8n.localhost (certificat interne) n'est joignable que depuis le serveur.
# Les webhooks ne sont jamais publiés : l'API joint n8n par le réseau Docker (http://n8n:5678).
{$N8N_DOMAIN:n8n.localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	@webhooks path /webhook/* /webhook-test/* /webhook-waiting/* /form/* /form-test/* /form-waiting/* /mcp/* /mcp-test/*
	respond @webhooks 404

	@outside not remote_ip {$N8N_ALLOWED_IPS:127.0.0.1/32}
	respond @outside 403

	reverse_proxy {$N8N_UPSTREAM:n8n:5678}
}

# Relais HTTPS interne vers le serveur de transcription (spec 010, research R11). Le port 8444 n'est
# jamais publié (docker-compose.yml) : seul le réseau Docker privé y accède. Certificat émis par
# l'autorité interne de Caddy, reconnu par l'API grâce à ASSIST_WHISPER_CA_FILE. Sans le profil
# « whisper », ce relais répond 502 ; aucun délai de lecture n'y est imposé (transcriptions longues).
https://caddy:8444 {
	tls internal

	request_body {
		max_size 26MB
	}
	reverse_proxy {$WHISPER_UPSTREAM:whisper:8000}
}
