# Copier en deploy/.env (jamais commité) puis adapter.

# Domaine public (enregistrement DNS A/AAAA vers le VPS) et e-mail pour Let's Encrypt
DOMAIN=demandes.ecole.example
ACME_EMAIL=informatique@ecole.example

# Base PostgreSQL (port non exposé)
POSTGRES_USER=app
POSTGRES_DB=app
# Générer : openssl rand -hex 32
POSTGRES_PASSWORD=

# Secret HMAC des sessions, au moins 32 caractères. Générer : openssl rand -base64 48
SESSION_SECRET=

# Sauvegardes : dossier de l'hôte (relatif à deploy/), heure quotidienne, conservation en jours
BACKUP_DIR=./backups
BACKUP_TIME=02:30
BACKUP_RETENTION_DAYS=14
TZ=Europe/Paris

# Copie hors du VPS (fortement recommandée) : dossier de l'hôte situé sur un autre support
# (partage réseau, stockage distant monté). Chaque sauvegarde réussie y est copiée.
# Exemple : BACKUP_OFFSITE_DIR=/mnt/sauvegardes-ecole
BACKUP_OFFSITE_DIR=
