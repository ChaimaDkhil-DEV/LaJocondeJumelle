# Copier en deploy/.env (jamais commité) puis adapter.

# Domaine public (enregistrement DNS A/AAAA vers le VPS) et e-mail pour Let's Encrypt
DOMAIN=demandes.ecole.example
ACME_EMAIL=informatique@ecole.example

# Base PostgreSQL (port non exposé)
POSTGRES_USER=app
POSTGRES_DB=app
# Générer : openssl rand -hex 32
POSTGRES_PASSWORD=

# Secret HMAC des sessions, au moins 32 caractères. Générer : openssl rand -base64 48
SESSION_SECRET=

# Sauvegardes : dossier de l'hôte (relatif à deploy/), heure quotidienne, conservation en jours
BACKUP_DIR=./backups
BACKUP_TIME=02:30
BACKUP_RETENTION_DAYS=14
TZ=Europe/Paris

# Fuseau de l'école pour les affectations (identifiant IANA ; défaut : TZ, sinon Europe/Paris)
# SCHOOL_TIMEZONE=Europe/Paris

# Âge maximal (minutes) de la sauvegarde exigée avant d'appliquer une migration (défaut : 60)
# PRE_MIGRATION_BACKUP_MAX_AGE_MINUTES=60

# Copie hors du VPS (fortement recommandée) : dossier de l'hôte situé sur un autre support
# (partage réseau, stockage distant monté). Chaque sauvegarde réussie y est copiée.
# Exemple : BACKUP_OFFSITE_DIR=/mnt/sauvegardes-ecole
BACKUP_OFFSITE_DIR=

# Assistance aux demandes (specs 009 et 010) : désactivée par défaut.
# Propositions : disabled, rules (règles et consignes, sans service externe ni frais), claude (payant).
# ASSIST_SUGGESTION_PROVIDER=rules
# Transcription : disabled, ou whisper (serveur local, profil « whisper » de docker-compose.yml).
# ASSIST_TRANSCRIPTION_PROVIDER=whisper
# Délai d'une transcription en ms (1000 à 300000 ; défaut de l'API, voir docs/validation/verification-011.md)
# ASSIST_TRANSCRIPTION_TIMEOUT_MS=
# Modèle Whisper (défaut Systran/faster-whisper-small) ; il doit être téléchargé sur le serveur.
# ASSIST_WHISPER_MODEL=
# Adresse et certificat : défauts adaptés au relais HTTPS interne de Caddy, à ne changer qu'en connaissance de cause.
# ASSIST_WHISPER_URL=https://caddy:8444
# ASSIST_WHISPER_CA_FILE=/caddy-data/caddy/pki/authorities/local/root.crt
# Connecteur Claude (payant, accord de traitement requis) : ne jamais commiter la clé.
# ANTHROPIC_API_KEY=
