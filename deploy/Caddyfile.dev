{
	# Pas d'ACME en développement : certificat émis par l'autorité interne de Caddy.
	local_certs
}

:8443 {
	tls internal

	handle /api/* {
		reverse_proxy host.docker.internal:3002
	}
	handle /socket.io/* {
		reverse_proxy host.docker.internal:3002
	}
	handle {
		reverse_proxy host.docker.internal:5173
	}
}
